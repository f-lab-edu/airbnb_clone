{
  "compilerOptions": {
    "target": "es6",
    "module": "esnext",
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["src/lib/*"],
      "@pages/*": ["src/pages/*"],
      "@components/*": ["src/components/*"],
      "@app/*": ["src/app/*"],
      "@/*": ["src/*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx", "global.d.ts"],
  "exclude": ["node_modules", "dist"]
}
